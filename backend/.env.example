# ScienceTech-IMS Backend Environment Configuration
# Copy this file to .env and adjust values as needed

# Application
APP_NAME=Scientech-IMS
APP_URL=http://localhost:8000
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
ALLOWED_HOSTS=["localhost","127.0.0.1"]
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174","http://localhost:5175","http://localhost:3000","https://amirotechsolutions.com","https://www.amirotechsolutions.com"]

# Server
HOST=0.0.0.0
PORT=8000

# Database
# Use a real PostgreSQL/Supabase URL in your deployment environment.
DATABASE_URL=postgresql+asyncpg://postgres:change-me@localhost:5432/ndt_ims
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_CONNECT_TIMEOUT_SECONDS=10
DATABASE_COMMAND_TIMEOUT_SECONDS=30

# JWT Authentication
JWT_SECRET_KEY=change-this-to-a-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# File Storage (local)
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./data/files
MAX_UPLOAD_SIZE_MB=50
ALLOWED_FILE_TYPES=[".pdf",".doc",".docx",".xls",".xlsx",".csv",".png",".jpg",".jpeg"]

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE_PATH=

# Email (local SMTP or console for dev)
# Set EMAIL_ENABLED=true to activate email notifications
EMAIL_ENABLED=false
EMAIL_BACKEND=console

# SMTP Configuration (for Gmail, Outlook, or custom SMTP)
# Gmail example:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=your-email@gmail.com
#   SMTP_PASSWORD=your-app-password (16-char App Password from Google Account > Security > App Passwords)
#   Note: You must enable 2FA and create an App Password at https://myaccount.google.com/apppasswords
# 
# Outlook example:
#   SMTP_HOST=smtp.office365.com
#   SMTP_PORT=587
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=Scientech-IMS

# Public demo request email (no calendar integration)
DEMO_REQUEST_ADMIN_EMAIL=your-admin-email@gmail.com
DEMO_REQUEST_EMAIL_ENABLED=true

# Scheduled IMS demo (Google Calendar and Meet)
GOOGLE_CALENDAR_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CALENDAR_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALENDAR_REFRESH_TOKEN=your-google-refresh-token
GOOGLE_CALENDAR_ID=your-calendar-id@gmail.com
DEMO_BOOKING_ADMIN_EMAIL=your-admin-email@gmail.com
DEMO_BOOKING_TIMEZONE=Asia/Kolkata
DEMO_BOOKING_START_HOUR=10
DEMO_BOOKING_END_HOUR=17
DEMO_BOOKING_DURATION_MINUTES=30
DEMO_BOOKING_DAYS_AHEAD=90
DEMO_BOOKING_EMAIL_ENABLED=true

# Demo request emails are delivered only to DEMO_REQUEST_ADMIN_EMAIL. Configure
# SMTP with an app-specific password to enable delivery.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=amirotechsolutions.sales@gmail.com
# SMTP_PASSWORD=your-google-app-password
# SMTP_USE_TLS=true
# SMTP_FROM_EMAIL=amirotechsolutions.sales@gmail.com
# SMTP_FROM_NAME=Amiro Tech Solutions

# Additional emails to receive low stock alerts (comma-separated)
# These are in addition to admin/manager users in the system
LOW_STOCK_ALERT_EMAILS=

# Archive & Data Retention
# GM/CEO emails to receive quarterly archive bundles and warning emails
# Leave empty to auto-use all ADMIN and HEAD_OFFICE_MANAGER user emails
ARCHIVE_RECIPIENT_EMAILS=
ARCHIVE_RETENTION_MONTHS=3
ARCHIVE_WARNING_DAYS=5

# Scheduler
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=UTC
REGISTER_EMAIL_INTERVAL_DAYS=30

# Alert Thresholds
EXPIRY_ALERT_DAYS=45
CALIBRATION_ALERT_DAYS=15
LOW_STOCK_CHECK_INTERVAL_HOURS=4

# Rate Limiting (in-memory)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_AUTH_REQUESTS_PER_MINUTE=10

# Security
PASSWORD_MIN_LENGTH=8
SESSION_TIMEOUT_MINUTES=480
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
DEMO_USER_EMAIL=demo.amiro@gmail.com
